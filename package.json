{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "my-project/*.{js,jsx,ts,tsx}": "cd my-project && eslint --fix",
    "my-project/*.{js,jsx,ts,tsx,json,css,md}": "cd my-project && prettier --write"
  }
}
